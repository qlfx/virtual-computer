variables = []
variable_values = []
variables_to_be_used = []

#我希望做的是：把代码分解为两部分，一部分存储关键字的指令，一部分进行变量绑定,
#代码句子的结束标志是空格，只有两个关键字，一个是쓰，代表打印，一个是것，代表变量
def split_code_to_command(code):
    #这段函数想做：通过空格区分开命令，解析
    commands = []
    return commands

def parse_command(command):
    #这一部分是想做未知变量解析
    if command[0] == '쓰':
        if command[1] not in variables_to_be_used and command[1] != ']' and command[1] != '[':
            variables_to_be_used.append[command[1]]
    #这一部分是想做变量登记
    if command[0] == '것':
        i = 1
        variables.append(command[0])
        for i < len(command):   #这个for循环我想做的是：只把方括号内的字符存入
            variable_values.append(command[i])

def parse_command_to_action(command):
    if command[0] == '쓰':
        if command[1] == ']':
            print(']')
        if command[1] == '[':
            print('[')
        if command[1] in variables_to_be_used:
            print(variable_values[0])

def compile(code):
    commands = split_code_to_command(code)
    for command in commands:
        parse_command(command)
    for command in commands:
        parse_command_to_action(command)

compile("쓰것 쓰[ 쓰것 쓰] 것:[쓰것 쓰[ 쓰것 쓰] 것:]")